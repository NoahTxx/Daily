<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Checkbox icon -->
    <ImageView
        android:id="@+id/widget_item_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Status"
        android:src="@drawable/widget_checkbox_unchecked" />

    <!-- Title and category/time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aufgabe"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_item_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Supplements"
            android:textColor="#7A7A85"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Reminder time pill if set -->
    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#1C1C22"
        android:fontFamily="monospace"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="08:30"
        android:textColor="#A0A0AA"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Counter Progress Badge (e.g. 3/10) -->
    <TextView
        android:id="@+id/widget_item_counter_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#16161C"
        android:fontFamily="monospace"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="0/10"
        android:textColor="#A0A0AA"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Dedicated +1/+10 Stepper Button for Counter Habits -->
    <TextView
        android:id="@+id/widget_item_counter_btn"
        android:layout_width="32dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_counter_btn_bg"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+1"
        android:textColor="#E52E2E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
