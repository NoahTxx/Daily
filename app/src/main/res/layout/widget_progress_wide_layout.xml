<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Left side: Percent column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_progress_wide_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/widget_dot_red" />

        <TextView
            android:id="@+id/widget_progress_wide_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="#E52E2E"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right side: Details & Progress bar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Header: "3 VON 4 ERLEDIGT" -->
        <TextView
            android:id="@+id/widget_progress_wide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:singleLine="true"
            android:text="0 VON 0 ERLEDIGT"
            android:textColor="#E6E6EC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- High-res custom rounded progress bar bitmap -->
        <ImageView
            android:id="@+id/widget_progress_wide_bar"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitXY" />

        <!-- Status subtitle: "NOCH 1 OFFEN" -->
        <TextView
            android:id="@+id/widget_progress_wide_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:singleLine="true"
            android:text="KEINE AUFGABEN"
            android:textColor="#888894"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
