<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Red accent dot -->
    <ImageView
        android:id="@+id/widget_streak_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/widget_dot_red" />

    <!-- Big streak count -->
    <TextView
        android:id="@+id/widget_streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="#E52E2E"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Clean label container with text -->
    <LinearLayout
        android:id="@+id/widget_streak_label_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_streak_label_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:singleLine="true"
            android:text="TAGE"
            android:textColor="#E6E6EC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_label_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:singleLine="true"
            android:text="STREAK"
            android:textColor="#888894"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
