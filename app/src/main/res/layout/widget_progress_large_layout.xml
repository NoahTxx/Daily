<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_progress_large_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_dot_red" />

        <TextView
            android:id="@+id/widget_progress_large_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:singleLine="true"
            android:text="TÄGLICHER FORTSCHRITT"
            android:textColor="#888894"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Circular gauge & Percent display -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Anti-aliased circular progress ring -->
        <ImageView
            android:id="@+id/widget_progress_large_gauge"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <!-- Center percentage & fraction -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_progress_large_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="0%"
                android:textColor="#E52E2E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_progress_large_fraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:singleLine="true"
                android:text="0 / 0"
                android:textColor="#888894"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom: Status / Summary pill -->
    <TextView
        android:id="@+id/widget_progress_large_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:singleLine="true"
        android:text="0 VON 0 ERLEDIGT"
        android:textColor="#E6E6EC"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
